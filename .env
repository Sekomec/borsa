# ============================================================
# QuantEdge AI — Environment Variables
# Bu dosyayı .env olarak kopyalayın ve gerçek API anahtarlarınızı girin
# cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Uygulama Ayarları
# ------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
API_V1_PREFIX=/api/v1
PROJECT_NAME=QuantEdge AI

# ------------------------------------------------------------
# Veritabanı (PostgreSQL + TimescaleDB)
# ------------------------------------------------------------
POSTGRES_USER=quantedge
POSTGRES_PASSWORD=quantedge_secret_2024
POSTGRES_DB=quantedge_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quantedge:quantedge_secret_2024@postgres:5432/quantedge_db

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300              # 5 dakika varsayılan cache süresi (saniye)
REDIS_PREDICTION_TTL=3600        # Tahmin cache süresi (1 saat)

# ------------------------------------------------------------
# ChromaDB (Vector Database)
# ------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# ------------------------------------------------------------
# MLflow
# ------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=quantedge_predictions

# ============================================================
# 📈 FİNANSAL VERİ API'LERİ
# ============================================================

# ------------------------------------------------------------
# Polygon.io — Ana piyasa verisi (OHLCV, tick data)
# Ücretsiz: https://polygon.io/dashboard
# Ücretli plan önerilir (Starter: $29/ay)
# ------------------------------------------------------------
POLYGON_API_KEY=_IbjxjiaXkj9Rik7lC4Q3JaBixE6OKUc

# ------------------------------------------------------------
# Alpha Vantage — Teknik göstergeler, temel veriler
# Ücretsiz: https://www.alphavantage.co/support/#api-key
# ------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=A7VLZBHK4ETXYE11

# ------------------------------------------------------------
# Finnhub — Temel analiz, kurumsal veri, haberler
# Ücretsiz plan mevcut: https://finnhub.io/register
# ------------------------------------------------------------
FINNHUB_API_KEY=d7j71jhr01qp3g1s25vgd7j71jhr01qp3g1s2600

# ------------------------------------------------------------
# IEX Cloud — Yedek piyasa verisi kaynağı
# https://iexcloud.io
# ------------------------------------------------------------
IEX_CLOUD_API_KEY=your_iex_cloud_key_here

# ============================================================
# 📰 HABER VE DUYGU ANALİZİ API'LERİ
# ============================================================

# ------------------------------------------------------------
# NewsAPI — Genel haber akışı
# Ücretsiz: https://newsapi.org/register
# ------------------------------------------------------------
NEWS_API_KEY=7d96f14adfe0490ea0c9281c90e6c54c

# ------------------------------------------------------------
# Reddit API (PRAW) — r/WallStreetBets, r/stocks
# https://www.reddit.com/prefs/apps
# ------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=QuantEdgeAI/1.0 by YourUsername

# ------------------------------------------------------------
# StockTwits — Borsa özel sosyal medya
# https://api.stocktwits.com/developers/apps
# ------------------------------------------------------------
STOCKTWITS_ACCESS_TOKEN=your_stocktwits_token_here

# ============================================================
# 🏛️ MAKROEKONOMİK VERİ API'LERİ
# ============================================================

# ------------------------------------------------------------
# FRED API (Federal Reserve Economic Data)
# Ücretsiz: https://fred.stlouisfed.org/docs/api/api_key.html
# 800,000+ ekonomik zaman serisi
# ------------------------------------------------------------
FRED_API_KEY=5967c867514662347a58c64c14a89228

# ------------------------------------------------------------
# BLS API (Bureau of Labor Statistics)
# Ücretsiz: https://www.bls.gov/developers/api_signature_v2.htm
# NFP, CPI, PPI verileri
# ------------------------------------------------------------
BLS_API_KEY=a479aa1f32ed49dea93b69a7b6ff1a4c

# ============================================================
# ⚙️ VERİ ÇEKME AYARLARI
# ============================================================

# Rate limiting (saniyede istek)
POLYGON_RATE_LIMIT=5
ALPHA_VANTAGE_RATE_LIMIT=5       # Ücretsiz: dakikada 5
FINNHUB_RATE_LIMIT=60

# Fallback zinciri sırası (virgülle ayrılmış)
MARKET_DATA_FALLBACK_CHAIN=polygon,alpha_vantage,finnhub,yfinance

# Piyasa saatleri (ET — Eastern Time)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0

# Veri güncelleme sıklıkları (saniye)
REALTIME_UPDATE_INTERVAL=60      # Anlık veri (piyasa açıkken)
SENTIMENT_UPDATE_INTERVAL=1800   # Duygu analizi (30 dakika)
MACRO_UPDATE_INTERVAL=86400      # Makro veri (günlük)
FUNDAMENTAL_UPDATE_INTERVAL=604800  # Temel analiz (haftalık)

# ============================================================
# 🤖 ML MODEL AYARLARI
# ============================================================

# Model yolları
MODEL_ARTIFACTS_PATH=/app/models/artifacts
FEATURE_STORE_PATH=/app/models/features

# LSTM hiperparametreleri
LSTM_SEQUENCE_LENGTH=60          # 60 günlük geçmiş pencere
LSTM_HIDDEN_UNITS=128
LSTM_DROPOUT=0.2
LSTM_EPOCHS=100
LSTM_BATCH_SIZE=32

# XGBoost
XGBOOST_N_ESTIMATORS=500
XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.01

# Ensemble ağırlıkları (toplam 1.0 olmalı)
# Günlük tahmin ağırlıkları
DAILY_WEIGHT_TECHNICAL=0.35
DAILY_WEIGHT_SENTIMENT=0.30
DAILY_WEIGHT_FUNDAMENTAL=0.20
DAILY_WEIGHT_MACRO=0.15

# Haftalık tahmin ağırlıkları
WEEKLY_WEIGHT_TECHNICAL=0.30
WEEKLY_WEIGHT_SENTIMENT=0.25
WEEKLY_WEIGHT_FUNDAMENTAL=0.25
WEEKLY_WEIGHT_MACRO=0.20

# Aylık tahmin ağırlıkları
MONTHLY_WEIGHT_TECHNICAL=0.20
MONTHLY_WEIGHT_SENTIMENT=0.15
MONTHLY_WEIGHT_FUNDAMENTAL=0.35
MONTHLY_WEIGHT_MACRO=0.30

# Yıllık tahmin ağırlıkları
YEARLY_WEIGHT_TECHNICAL=0.10
YEARLY_WEIGHT_SENTIMENT=0.05
YEARLY_WEIGHT_FUNDAMENTAL=0.45
YEARLY_WEIGHT_MACRO=0.40

# ============================================================
# 🔐 GÜVENLİK
# ============================================================
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ============================================================
# 📊 İZLEME
# ============================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SENTRY_DSN=                      # İsteğe bağlı: Hata izleme için
